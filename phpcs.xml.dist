<?xml version="1.0"?>
<ruleset name="Webgram">
	<description>Webgram Theme and Webgram Core coding standards: WordPress-Extra plus WooCommerce sniffs.</description>
	<file>webgram-theme</file>
	<file>webgram-core</file>
	<file>webgram-child</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/demo/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="WordPress-Extra">
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Generic.Commenting.DocComment"/>
		<exclude name="Squiz.Commenting"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
		<exclude name="WordPress.WhiteSpace.OperatorSpacing"/>
		<exclude name="Generic.WhiteSpace.ScopeIndent"/>
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="Universal.WhiteSpace.PrecisionAlignment"/>
		<exclude name="Universal.Files.SeparateFunctionsFromOO"/>
		<exclude name="Universal.CodeAnalysis.ConstructorDestructorReturn"/>
		<!-- Project hook convention is webgram/area/event and webgram_core/module/event (CLAUDE.md); all hooks carry the prefix. -->
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound"/>
		<!-- Anonymous AjaxHandler classes live next to the module that owns them. -->
		<exclude name="Generic.Files.OneObjectStructurePerFile"/>
		<!-- Interface and hook callback signatures keep unused parameters on purpose. -->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
		<!-- Admin pickers query up to 300 items on purpose. -->
		<exclude name="WordPress.WP.PostsPerPage"/>
	</rule>
	<rule ref="WooCommerce-Core">
		<exclude name="WooCommerce.Commenting"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="webgram"/>
				<element value="webgram-core"/>
				<element value="woocommerce"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="webgram"/>
				<element value="Webgram"/>
				<element value="WEBGRAM"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="edit_shop_orders"/>
				<element value="view_woocommerce_reports"/>
				<element value="edit_products"/>
				<element value="edit_product"/>
			</property>
		</properties>
	</rule>
	<!-- Template files run inside get_template_part(), wc_get_template() or the Core Template renderer (function scope), so their variables are not globals. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>*/templates/*</exclude-pattern>
		<exclude-pattern>*/template-parts/*</exclude-pattern>
		<exclude-pattern>*/woocommerce/*</exclude-pattern>
		<exclude-pattern>*/page-templates/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<element value="webgram_icon"/>
				<element value="webgram_payment_icon"/>
			</property>
		</properties>
	</rule>
</ruleset>
