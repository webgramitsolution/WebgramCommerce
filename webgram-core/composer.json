{
    "name": "webgram/webgram-core",
    "description": "Webgram Core: functionality plugin for the Webgram WooCommerce theme.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.1"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": false
    },
    "prefer-stable": true
}
